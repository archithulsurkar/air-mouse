<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Swipe-to-dismiss would steal the scroll swipes on the touch pad. -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault">
        <item name="android:windowSwipeToDismiss">false</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorAccent">@color/primary</item>
    </style>

    <style name="PillButton">
        <item name="android:background">@drawable/bg_button_filled</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingHorizontal">24dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="PillButton.Small">
        <item name="android:background">@drawable/bg_button_tonal</item>
        <item name="android:textColor">@color/on_secondary_container</item>
        <item name="android:textSize">13sp</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:paddingHorizontal">16dp</item>
    </style>

    <style name="NavButton">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/bg_nav_button</item>
        <item name="android:textColor">@color/on_secondary_container</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
